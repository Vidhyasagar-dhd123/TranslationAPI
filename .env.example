# Django Settings
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database URL (Provided automatically by Render if PostgreSQL is attached)
# PostgreSQL Example: postgres://translation_user:password@hostname:5432/translation_api
# SQLite Example (default fallback): sqlite:///db.sqlite3
DATABASE_URL=sqlite:///db.sqlite3

# Hugging Face Token (Optional, for downloading private or gated models)
HUGGINGFACE_TOKEN=
